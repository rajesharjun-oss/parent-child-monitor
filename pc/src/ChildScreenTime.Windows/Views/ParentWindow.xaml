<Window x:Class="ChildScreenTime.Windows.Views.ParentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parent controls — Child Screen Time" Width="1040" Height="760"
        MinWidth="900" MinHeight="650" WindowStartupLocation="CenterOwner">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Parent controls" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="Usage, limits, schedules, application rules, and security history" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,15" />
            </StackPanel>
            <Button Grid.Column="1" Content="Export usage CSV" Click="Export_Click" VerticalAlignment="Top" />
        </Grid>

        <TabControl Grid.Row="1" x:Name="ParentTabs">
            <TabItem Header="Activity">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Today:" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="TodayTotalText" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <DataGrid Grid.Row="1" x:Name="UsageGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="130" />
                            <DataGridTextColumn Header="Application" Binding="{Binding Application}" Width="*" />
                            <DataGridTextColumn Header="Process" Binding="{Binding Process}" Width="180" />
                            <DataGridTextColumn Header="Active minutes" Binding="{Binding Minutes}" Width="130" />
                            <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeen}" Width="185" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Limits &amp; schedule">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20" Width="600" HorizontalAlignment="Left">
                        <CheckBox x:Name="MonitoringEnabled" Content="Monitoring and restrictions enabled" FontWeight="SemiBold" Margin="0,0,0,18" />
                        <TextBlock Text="Daily screen-time limit (minutes)" FontWeight="SemiBold" />
                        <TextBox x:Name="DailyLimit" AutomationProperties.Name="Daily screen-time limit in minutes" />

                        <CheckBox x:Name="BedtimeEnabled" Content="Enable bedtime schedule" FontWeight="SemiBold" Margin="0,10,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Starts (HH:mm)" FontWeight="SemiBold" />
                                <TextBox x:Name="BedtimeStart" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Ends (HH:mm)" FontWeight="SemiBold" />
                                <TextBox x:Name="BedtimeEnd" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Activity retention (days)" FontWeight="SemiBold" Margin="0,10,0,0" />
                        <TextBox x:Name="RetentionDays" />

                        <Border Background="#FFF4E5" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                            <TextBlock Text="Pausing monitoring is recorded in the audit history. Existing activity remains encrypted and follows the retention setting." TextWrapping="Wrap" Foreground="#7A4D00" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Application rules">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="RulesGrid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Process name" Binding="{Binding ProcessName}" Width="210" />
                            <DataGridTextColumn Header="Display name" Binding="{Binding DisplayName}" Width="*" />
                            <DataGridTextColumn Header="Daily limit (min)" Binding="{Binding DailyLimitMinutes}" Width="140" />
                            <DataGridCheckBoxColumn Header="Always blocked" Binding="{Binding AlwaysBlocked}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NewProcessName" ToolTip="Process name, for example game.exe" Margin="0" />
                        <TextBox Grid.Column="2" x:Name="NewDisplayName" ToolTip="Friendly application name" Margin="0" />
                        <TextBox Grid.Column="4" x:Name="NewRuleLimit" ToolTip="Optional daily limit in minutes" Margin="0" />
                        <Button Grid.Column="5" Content="Add rule" Click="AddRule_Click" />
                        <Button Grid.Column="6" Content="Remove selected" Click="RemoveRule_Click" />
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Security &amp; audit">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Change parent password" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="The current password is required again for this sensitive action." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,14" />
                        <TextBlock Text="Current password" FontWeight="SemiBold" />
                        <PasswordBox x:Name="CurrentPassword" />
                        <TextBlock Text="New password" FontWeight="SemiBold" />
                        <PasswordBox x:Name="NewPassword" />
                        <TextBlock Text="Confirm new password" FontWeight="SemiBold" />
                        <PasswordBox x:Name="ConfirmNewPassword" />
                        <Button Content="Change password" Click="ChangePassword_Click" HorizontalAlignment="Left" Background="{StaticResource BrandBrush}" Foreground="White" />
                        <TextBlock x:Name="PasswordMessage" TextWrapping="Wrap" Margin="4,10,0,0" />
                        <Separator Margin="0,24,0,18" />
                        <TextBlock Text="Privacy controls" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="Deleting activity history is permanent and requires the parent password." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,10" />
                        <Button Content="Delete all activity history" Click="DeleteHistory_Click" HorizontalAlignment="Left" Foreground="#B42318" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Recent security and control activity" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <DataGrid x:Name="AuditGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="170" />
                                <DataGridTextColumn Header="Event" Binding="{Binding Event}" Width="170" />
                                <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SaveMessage" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button Grid.Column="1" Content="Close" IsCancel="True" />
            <Button Grid.Column="2" Content="Save controls" Click="Save_Click" IsDefault="True" Background="{StaticResource BrandBrush}" Foreground="White" FontWeight="SemiBold" />
        </Grid>
    </Grid>
</Window>
