<Window x:Class="ChildScreenTime.Windows.Views.BlockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        Background="#101729" WindowStartupLocation="Manual">
    <Grid>
        <StackPanel Width="580" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="White">
            <Border Width="76" Height="76" CornerRadius="38" Background="#28406F" HorizontalAlignment="Center">
                <TextBlock Text="⏱" FontSize="38" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Screen time paused" FontSize="42" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,24,0,12" />
            <TextBlock x:Name="ReasonText" FontSize="19" Foreground="#C9D3EA" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Text="Monitoring is visible and records only application names and active duration." Foreground="#95A3C2" TextAlignment="Center" TextWrapping="Wrap" Margin="0,18,0,18" />
            <Button x:Name="ParentAccessButton" Content="Parent access" Click="ParentAccess_Click" Width="180" Background="#5C7CFA" Foreground="White" FontWeight="SemiBold" />
        </StackPanel>
    </Grid>
</Window>
