<Window x:Class="ChildScreenTime.Windows.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Child Screen Time" Width="760" Height="520" MinWidth="680" MinHeight="470"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Child Screen Time" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="This PC is managed with transparent parental controls" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
            </StackPanel>
            <Border Grid.Column="1" x:Name="StatusBadge" Background="#E7F7EE" CornerRadius="16" Padding="13,7" VerticalAlignment="Top">
                <TextBlock x:Name="StatusText" Text="Monitoring active" Foreground="#067647" FontWeight="SemiBold" />
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="0,30,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="18" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="24">
                <StackPanel>
                    <TextBlock Text="TIME REMAINING TODAY" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" FontSize="12" />
                    <TextBlock x:Name="RemainingTimeText" Text="—" FontSize="48" FontWeight="SemiBold" Margin="0,10,0,0" />
                    <TextBlock x:Name="UsedTimeText" Text="Calculating today's usage…" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="24">
                <StackPanel>
                    <TextBlock Text="CURRENT ACTIVITY" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" FontSize="12" />
                    <TextBlock x:Name="CurrentAppText" Text="Waiting for activity…" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,14,0,8" />
                    <TextBlock Text="Only the application name and active duration are recorded." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Closing this window keeps monitoring active in the notification area." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Parent controls" Click="ParentControls_Click" Background="{StaticResource BrandBrush}" Foreground="White" FontWeight="SemiBold" />
        </Grid>
    </Grid>
</Window>
