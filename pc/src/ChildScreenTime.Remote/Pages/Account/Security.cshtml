@page
@model SecurityModel
@{
    ViewData["Title"] = "Account security";
}
<section class="auth-card security-card">
    <p class="eyebrow">Account protection</p>
    <h1>Authenticator app</h1>
    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage)) { <div class="notice" role="status">@Model.StatusMessage</div> }
    @if (Model.IsEnabled)
    {
        <p>Two-factor authentication is enabled.</p>
        <form method="post" asp-page-handler="Disable">
            <label for="disable-password">Current password</label>
            <input id="disable-password" name="currentPassword" type="password" autocomplete="current-password" required minlength="12" maxlength="128" />
            <button class="button danger" type="submit">Disable two-factor authentication</button>
        </form>
    }
    else
    {
        <ol>
            <li>Add a new account in your authenticator app.</li>
            <li>Enter this setup key manually: <code class="setup-key">@Model.SharedKey</code></li>
            <li>Confirm with the six-digit code and your password.</li>
        </ol>
        <form method="post" asp-page-handler="Enable">
            <label for="enable-password">Current password</label>
            <input id="enable-password" name="currentPassword" type="password" autocomplete="current-password" required minlength="12" maxlength="128" />
            <label for="auth-code">Six-digit authenticator code</label>
            <input id="auth-code" name="code" autocomplete="one-time-code" inputmode="numeric" required minlength="6" maxlength="8" />
            <button class="button primary" type="submit">Enable two-factor authentication</button>
        </form>
    }
    @if (Model.RecoveryCodes.Count > 0)
    {
        <section class="recovery-codes">
            <h2>Save these one-time recovery codes now</h2>
            <p>Store them in a password manager. They will not be shown again.</p>
            <ul>@foreach (var code in Model.RecoveryCodes) { <li><code>@code</code></li> }</ul>
        </section>
    }
</section>
