@page
@model TwoFactorModel
@{
    ViewData["Title"] = "Two-factor verification";
}
<section class="auth-card">
    <p class="eyebrow">Additional verification</p>
    <h1>Enter your security code</h1>
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="validation" role="alert"></div>
        <input type="hidden" asp-for="ReturnUrl" />
        <input type="hidden" asp-for="RememberMe" />
        <label asp-for="Code">Authenticator or recovery code</label>
        <input asp-for="Code" autocomplete="one-time-code" inputmode="numeric" />
        <span asp-validation-for="Code" class="validation"></span>
        <label class="checkbox"><input asp-for="RememberMachine" /> Remember this browser</label>
        <button class="button primary" type="submit">Verify</button>
    </form>
</section>
