CST_ConnectionStrings__RemoteDatabase=Host=database;Port=5432;Database=child_screen_time;Username=child_screen_time;Password=replace-with-a-long-random-password
CST_Remote__RegistrationInviteCode=replace-with-a-separate-long-random-invite-code
CST_Remote__DataProtectionKeyPath=/var/lib/child-screen-time/keys
CST_Remote__ApplyMigrationsOnStartup=true
CST_Remote__DataRetentionDays=90
CST_AllowedHosts=monitor.example.com
POSTGRES_DB=child_screen_time
POSTGRES_USER=child_screen_time
POSTGRES_PASSWORD=replace-with-the-same-database-password
